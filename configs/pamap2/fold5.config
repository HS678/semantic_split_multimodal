[config]
experiment_name=pamap2_formal_msl_fold5
seed=42
device=auto
num_classes=12
base_dir=./local/results_msl

[partition]
type=pamap2
root=./local/datasets/pamap2
split_protocol=subject_9fold_loso_fold5
clients_per_modality=10

[cluster]
pretrain_objective=classification
pretrain_epochs=30
pretrain_batch_size=64
pretrain_lr=0.0003
pretrain_class_weighting=true
fingerprint_type=signal
method=adaptive_isodata
known_k=null
adaptive_seeds=[11,23,37,53,71]
adaptive_max_iter=20
adaptive_pca_variance=0.95
adaptive_variance_epsilon=1e-08
adaptive_q_max=8
adaptive_min_cluster_size=2
adaptive_min_cluster_size_fraction=null
adaptive_bic_improvement_min=0.0
adaptive_min_split_silhouette=0.2
adaptive_silhouette_patience=2
adaptive_stability_min_ari=0.75
adaptive_split_kmeans_restarts=50

[train]
cluster_assignment_source=true_cluster
scheduler=balanced_cluster_round_robin
global_rounds=200
local_steps=1
batch_size=64
eval_batch_size=128
clients_per_cluster_per_round=4
client_lr=0.0001
server_lr=0.0001
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=true
encoder_type=temporal_conv_gru
encoder_conv_channels=[64,128,256]
encoder_kernel_sizes=[7,5,3]
encoder_gru_hidden_dim=128
encoder_gru_layers=2
encoder_bidirectional=true
encoder_pooling=attention
encoder_dropout=0.2
binding_type=label_random
binding_batch_size=64
fusion_type=concat_mlp
fusion_training_objective=mmbind_weighted_contrastive
fusion_adapter_dim=128
fusion_hidden_dim=256
fusion_num_layers=2
fusion_dropout=0.2
mmbind_temperature=0.1
mmbind_contrastive_weight=0.05
mmbind_heterogeneous_ce_weight=0.25
run_test=true

[d2d]
enabled=false

[other]
fingerprint_visualization=true
