[config]
experiment_name=pamap2_msl_fold7
base_dir=./local/results_msl

[partition]
type=pamap2
split_protocol=subject_9fold_loso_fold7
clients_per_modality=10

[train]
cluster_assignment_source=true_cluster
scheduler=balanced_cluster_round_robin
clients_per_cluster_per_round=2
fusion_training_objective=mmbind_weighted_contrastive
global_rounds=300

# D2D 计算卸载模块：尚未实现，保留扩展口（正式实验保持 false）。
[d2d]
enabled=false

# 杂项/可视化：fingerprint_visualization 控制 Stage2 指纹 PCA 审计图输出。
[other]
fingerprint_visualization=true
