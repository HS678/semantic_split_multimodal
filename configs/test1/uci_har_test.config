[config]
extends=../uci_har.config

seed=42
experiment_name=uci_har_test_stratified_partition

[stage2]
run_name=test_adaptive_isodata

[stage3]
stage2_dir=./local/results/cluster/uci_har/acc_10clients_gyro_10clients__subject_disjoint_tvt_v1/adaptive_isodata/test_adaptive_isodata


[partition]
clients_per_modality=10


[fingerprint]
type=hybrid


[cluster]
method=adaptive_isodata
known_k=null


[training]
global_rounds=200
validation_every=10
clients_per_cluster_per_round=4
client_lr=0.001
server_lr=0.001


[evaluation]
run_test=true