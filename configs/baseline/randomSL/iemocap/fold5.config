# randomSL baseline: 随机调度 Split Learning（唯一差异 = 调度器，其余继承主线）。
[config]
extends=../../../iemocap/fold5.config
experiment_name=iemocap_random_sl_fold5
base_dir=./local/results_baseline/randomSL

[train]
scheduler=random

[stage3]
stage1_dir=./local/results_msl/partition/iemocap/audio_10clients_video_10clients_text_10clients__session_5fold_loso_fold5
stage2_dir=./local/results_msl/cluster/iemocap/audio_10clients_video_10clients_text_10clients__session_5fold_loso_fold5/adaptive_isodata
output_root=./local/results_baseline/randomSL/experiments
