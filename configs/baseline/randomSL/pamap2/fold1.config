# randomSL baseline: 随机调度 Split Learning（唯一差异 = 调度器，其余继承主线）。
[config]
extends=../../../pamap2/fold1.config
experiment_name=pamap2_random_sl_fold1
base_dir=./local/results_baseline/randomSL

[train]
scheduler=random

[stage3]
stage1_dir=./local/results_msl/partition/pamap2/acc_10clients_gyro_10clients_mag_10clients__subject_9fold_loso_fold1
stage2_dir=./local/results_msl/cluster/pamap2/acc_10clients_gyro_10clients_mag_10clients__subject_9fold_loso_fold1/adaptive_isodata
output_root=./local/results_baseline/randomSL/experiments
