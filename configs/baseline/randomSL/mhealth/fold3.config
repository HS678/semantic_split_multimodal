# randomSL baseline: 随机调度 Split Learning（唯一差异 = 调度器，其余继承主线）。
[config]
extends=../../../mhealth/fold3.config
experiment_name=mhealth_random_sl_fold3
base_dir=./local/results_baseline/randomSL

[train]
scheduler=random

[stage3]
stage1_dir=./local/results_msl/partition/mhealth/acc_10clients_gyro_10clients_mag_10clients_ecg_10clients__subject_5fold_fold3
stage2_dir=./local/results_msl/cluster/mhealth/acc_10clients_gyro_10clients_mag_10clients_ecg_10clients__subject_5fold_fold3/adaptive_isodata
output_root=./local/results_baseline/randomSL/experiments
