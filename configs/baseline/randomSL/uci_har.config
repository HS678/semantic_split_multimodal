# randomSL baseline 独立配置：不继承主线。实验参数与主线当前正式配置保持一致，
# 仅调度器（random）与结果目录不同；主线参数变更后需手动同步本文件。
[config]
experiment_name=uci_har_random_sl
base_dir=./local/results_baseline/randomSL

[partition]
type=uci_har
split_protocol=subject_disjoint_70_30
clients_per_modality=10

[train]
cluster_assignment_source=true_cluster
scheduler=random
clients_per_cluster_per_round=2
fusion_training_objective=mmbind_weighted_contrastive
global_rounds=200

# D2D 计算卸载模块：尚未实现，保留扩展口（正式实验保持 false）。
[d2d]
enabled=false

# 杂项/可视化：fingerprint_visualization 控制 Stage2 指纹 PCA 审计图输出。
[other]
fingerprint_visualization=true

[stage3]
stage1_dir=./local/results_msl/partition/uci_har/acc_10clients_gyro_10clients__subject_disjoint_70_30
stage2_dir=./local/results_msl/cluster/uci_har/acc_10clients_gyro_10clients__subject_disjoint_70_30/adaptive_isodata
output_root=./local/results_baseline/randomSL/experiments
