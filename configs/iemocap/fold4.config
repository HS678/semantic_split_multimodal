[config]
seed=42
device=auto
experiment_name=iemocap_formal_msl_fold4
num_classes=4
encoder_hidden_dim=128

[results]
base_dir=./local/results_msl

[stage2]
stage1_dir=./local/results_msl/partition/iemocap/audio_10clients_video_10clients_text_10clients__session_5fold_loso_fold4
output_root=./local/results_msl/cluster
run_name=mobilevit_bigru_attention_cls_v1

[stage3]
stage1_dir=./local/results_msl/partition/iemocap/audio_10clients_video_10clients_text_10clients__session_5fold_loso_fold4
stage2_dir=./local/results_msl/cluster/iemocap/audio_10clients_video_10clients_text_10clients__session_5fold_loso_fold4/adaptive_isodata/mobilevit_bigru_attention_cls_v1
output_root=./local/results_msl/experiments
attempt=1

[dataset]
type=iemocap
name=iemocap
variant=full
root=./local/datasets/IEMOCAP/IEMOCAP_full/IEMOCAP_full_release
processed_root=./local/datasets/IEMOCAP/processed/mfcc_mobilevit_xs_distilbert_v1
feature_recipe=mfcc_mobilevit_xs_distilbert_v1
split_protocol=session_5fold_loso_fold4
task=emotion_4class
label_protocol=ang_hap_exc_sad_neu_v1
normalize=true

[model.encoder]
type=gru
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[model.encoders.conv_gru]
conv_channels=[64,128,256]
kernel_size=5
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[model.encoders.gru]
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[partition]
clients_per_modality=10

[pretrain]
objective=classification
epochs=25
batch_size=32
lr=0.0002
weight_decay=0.0001
class_weighting=inverse_sqrt
max_grad_norm=5.0

[fingerprint]
type=hybrid
batch_size=64
max_batches=4

[fingerprint_visualization]
enabled=true
method=pca
standardize=true
show_client_ids=false
show_ellipses=true
ellipse_confidence=0.95
png_dpi=600

[cluster]
method=adaptive_isodata
known_k=null

[cluster.adaptive]
seeds=[11,23,37,53,71]
max_iter=20
pca_variance=0.95
variance_epsilon=1e-08
q_max=8
min_cluster_size=2
min_cluster_size_fraction=null
bic_improvement_min=0.0
min_split_silhouette=0.2
silhouette_patience=2
stability_min_ari=0.75
split_kmeans_restarts=50

[training]
cluster_assignment_source=true_cluster
scheduler=balanced_cluster_round_robin
global_rounds=200
validation_enabled=false
local_steps=1
batch_size=32
eval_batch_size=64
clients_per_cluster_per_round=4
client_lr=0.0001
server_lr=0.0001
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=inverse_sqrt

[binding]
type=label_random
batch_size=32

[fusion]
type=concat_mlp
training_objective=mmbind_weighted_contrastive
adapter_dim=128
hidden_dim=256
num_layers=2
dropout=0.3

[fusion.mmbind]
temperature=0.1
contrastive_weight=0.03
heterogeneous_ce_weight=0.15

[evaluation]
run_test=true

[d2d]
enabled=false
