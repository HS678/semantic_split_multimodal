[config]
experiment_name=iemocap_formal_msl_fold5
seed=42
device=auto
num_classes=4
base_dir=./local/results_msl

[partition]
type=iemocap
name=iemocap
variant=full
root=./local/datasets/IEMOCAP/IEMOCAP_full/IEMOCAP_full_release
processed_root=./local/datasets/IEMOCAP/processed/mfcc_mobilevit_xs_distilbert_v1
feature_recipe=mfcc_mobilevit_xs_distilbert_v1
split_protocol=session_5fold_loso_fold5
task=emotion_4class
label_protocol=ang_hap_exc_sad_neu_v1
clients_per_modality=10

[cluster]
pretrain_objective=classification
pretrain_epochs=25
pretrain_batch_size=32
pretrain_lr=0.0002
pretrain_class_weighting=true
fingerprint_type=hybrid
method=adaptive_isodata
known_k=null
adaptive_seeds=[11,23,37,53,71]
adaptive_max_iter=20
adaptive_pca_variance=0.95
adaptive_variance_epsilon=1e-08
adaptive_q_max=8
adaptive_min_cluster_size=2
adaptive_min_cluster_size_fraction=null
adaptive_bic_improvement_min=0.0
adaptive_min_split_silhouette=0.2
adaptive_silhouette_patience=2
adaptive_stability_min_ari=0.75
adaptive_split_kmeans_restarts=50

[train]
cluster_assignment_source=true_cluster
scheduler=balanced_cluster_round_robin
global_rounds=200
local_steps=1
batch_size=32
eval_batch_size=64
clients_per_cluster_per_round=4
client_lr=0.0001
server_lr=0.0001
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=true
encoder_type=gru
encoder_gru_hidden_dim=256
encoder_gru_layers=2
encoder_bidirectional=true
encoder_pooling=attention
encoder_dropout=0.2
binding_type=label_random
binding_batch_size=32
fusion_type=concat_mlp
fusion_training_objective=mmbind_weighted_contrastive
fusion_adapter_dim=128
fusion_hidden_dim=256
fusion_num_layers=2
fusion_dropout=0.3
mmbind_temperature=0.1
mmbind_contrastive_weight=0.03
mmbind_heterogeneous_ce_weight=0.15
run_test=true

[train.encoders.conv_gru]
conv_channels=[64,128,256]
kernel_size=5
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[train.encoders.gru]
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[d2d]
enabled=false

[other]
fingerprint_visualization=true
