[config]
extends=../iemocap.config
seed=101
experiment_name=iemocap_mmbind_loso_mobilevit_bigru_attention_formal
encoder_hidden_dim=256

[dataset]
split_strategy=session_loso_5fold_group_validation_v1
split_protocol=iemocap_session_loso_fold5_v1
train_sessions=[1,2,3,4]
validation_sessions=[]
test_sessions=[5]
validation_folds=8
validation_fold_index=0
validation_seed=101

[stage2]
stage1_dir=./local/results/partition/iemocap/audio_10clients_video_10clients_text_10clients__iemocap_session_loso_fold5_v1
output_root=./local/results/cluster
run_name=mobilevit_bigru_attention_cls_v1

[stage3]
stage1_dir=./local/results/partition/iemocap/audio_10clients_video_10clients_text_10clients__iemocap_session_loso_fold5_v1
stage2_dir=./local/results/cluster/iemocap/audio_10clients_video_10clients_text_10clients__iemocap_session_loso_fold5_v1/adaptive_isodata/mobilevit_bigru_attention_cls_v1
output_root=./local/results/experiments
attempt=1

[model.encoder]
type=gru
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[model.encoders.conv_gru]
conv_channels=[64,128,256]
kernel_size=5
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[model.encoders.gru]
gru_hidden_dim=256
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[pretrain]
objective=classification
epochs=25
batch_size=32
lr=0.0002
weight_decay=0.0001
class_weighting=inverse_sqrt
max_grad_norm=5.0

[training]
global_rounds=300
local_steps=1
batch_size=32
eval_batch_size=64
validation_every=10
clients_per_cluster_per_round=4
client_lr=0.0001
server_lr=0.0001
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=inverse_sqrt

[training.early_stopping]
patience=7
min_rounds=100
min_delta=0.0005

[binding]
type=label_random
batch_size=32

[fusion]
training_objective=mmbind_weighted_contrastive
adapter_dim=128
hidden_dim=256
num_layers=2
dropout=0.3

[fusion.mmbind]
temperature=0.1
contrastive_weight=0.03
heterogeneous_ce_weight=0.15

[evaluation]
run_test=true
