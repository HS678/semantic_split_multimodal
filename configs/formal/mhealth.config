[config]
extends=../mhealth.config
seed=101
experiment_name=mhealth_mmbind_temporal_bigru_attention_formal
encoder_hidden_dim=128

[stage2]
run_name=signal_stats_cls_cluster_v2

[stage3]
stage2_dir=./local/results/cluster/mhealth/accelerometer_10clients_gyroscope_10clients_magnetometer_10clients_ecg_10clients__subject_disjoint_tvt_v1/adaptive_isodata/signal_stats_cls_cluster_v2

[model.encoder]
type=temporal_conv_gru
conv_channels=[64,128,128]
kernel_sizes=[7,5,3]
gru_hidden_dim=128
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.15

[pretrain]
objective=classification
epochs=25
batch_size=64
lr=0.0005
weight_decay=0.0001
class_weighting=inverse_sqrt
max_grad_norm=5.0

[fingerprint]
type=signal

[cluster.adaptive]
bic_improvement_min=40.0

[training]
global_rounds=300
local_steps=1
batch_size=64
eval_batch_size=128
validation_every=10
clients_per_cluster_per_round=4
client_lr=0.0002
server_lr=0.0002
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=inverse_sqrt

[training.early_stopping]
patience=6
min_rounds=80
min_delta=0.0005

[fusion]
training_objective=mmbind_weighted_contrastive
adapter_dim=128
hidden_dim=256
num_layers=2
dropout=0.15

[fusion.mmbind]
temperature=0.1
contrastive_weight=0.1
heterogeneous_ce_weight=0.5

[evaluation]
run_test=true
