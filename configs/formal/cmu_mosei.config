[config]
extends=../cmu_mosei.config
seed=101
experiment_name=cmu_mosei_mmbind_normalized_mlp_formal
encoder_hidden_dim=128

[stage2]
run_name=normalized_mlp_cls_v1

[stage3]
stage2_dir=./local/results/cluster/cmu_mosei/text_10clients_audio_10clients_visual_10clients__official_video_disjoint_tvt_v1/adaptive_isodata/normalized_mlp_cls_v1

[model.encoder]
type=mlp
layer_dims=[256,128]
layer_norm=true
dropout=0.2

[pretrain]
objective=classification
epochs=15
batch_size=64
lr=0.0003
weight_decay=0.0001
class_weighting=none
max_grad_norm=5.0

[training]
global_rounds=200
local_steps=1
batch_size=64
eval_batch_size=256
validation_every=10
clients_per_cluster_per_round=4
client_lr=0.0001
server_lr=0.0001
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=none

[training.early_stopping]
patience=6
min_rounds=60
min_delta=0.0005

[fusion]
training_objective=mmbind_weighted_contrastive
adapter_dim=128
hidden_dim=256
num_layers=2
dropout=0.2

[fusion.mmbind]
temperature=0.1
contrastive_weight=0.02
heterogeneous_ce_weight=0.1

[evaluation]
run_test=true
