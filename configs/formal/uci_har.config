[config]
extends=../uci_har.config
seed=101
experiment_name=uci_har_mmbind_temporal_bigru_attention_formal
encoder_hidden_dim=128

[stage2]
run_name=temporal_bigru_attention_cls_v1

[stage3]
stage2_dir=./local/results/cluster/uci_har/acc_10clients_gyro_10clients__subject_disjoint_tvt_v1/adaptive_isodata/temporal_bigru_attention_cls_v1

[model.encoder]
type=temporal_conv_gru
conv_channels=[64,128,128]
kernel_sizes=[7,5,3]
gru_hidden_dim=128
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.2

[pretrain]
objective=classification
epochs=25
batch_size=64
lr=0.0005
weight_decay=0.0001
class_weighting=none
max_grad_norm=5.0

[cluster.adaptive]
min_split_silhouette=0.10

[training]
global_rounds=300
local_steps=1
batch_size=64
eval_batch_size=128
validation_every=10
clients_per_cluster_per_round=4
client_lr=0.0002
server_lr=0.0002
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=none

[training.early_stopping]
patience=6
min_rounds=80
min_delta=0.0005

[fusion]
training_objective=mmbind_weighted_contrastive
adapter_dim=128
hidden_dim=256
num_layers=2
dropout=0.2

[fusion.mmbind]
temperature=0.1
contrastive_weight=0.02
heterogeneous_ce_weight=0.1

[evaluation]
run_test=true
