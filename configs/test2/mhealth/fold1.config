[config]
seed=42
device=auto
experiment_name=mhealth_formal_test2_fold1
num_classes=12
encoder_hidden_dim=128

[results]
base_dir=./local/results_test2

[stage2]
stage1_dir=./local/results_test2/partition/mhealth/accelerometer_10clients_gyroscope_10clients_magnetometer_10clients_ecg_10clients__subject_5fold_no_val_fold1_v1
output_root=./local/results_test2/cluster
run_name=signal_stats_cls_cluster_v2

[stage3]
stage1_dir=./local/results_test2/partition/mhealth/accelerometer_10clients_gyroscope_10clients_magnetometer_10clients_ecg_10clients__subject_5fold_no_val_fold1_v1
stage2_dir=./local/results_test2/cluster/mhealth/accelerometer_10clients_gyroscope_10clients_magnetometer_10clients_ecg_10clients__subject_5fold_no_val_fold1_v1/adaptive_isodata/signal_stats_cls_cluster_v2
output_root=./local/results_test2/experiments
attempt=1

[dataset]
type=mhealth
root=./local/datasets/mhealth
split_protocol=subject_5fold_no_val_fold1_v1
modality_scheme=sensor_type
train_subjects=[2, 3, 4, 5, 6, 7, 8, 9]
validation_subjects=[]
test_subjects=[1, 10]
window_size=128
stride=64
drop_null=true
min_label_purity=0.6
normalize=true

[model.encoder]
type=temporal_conv_gru
conv_channels=[64,128,128]
kernel_sizes=[7,5,3]
gru_hidden_dim=128
gru_layers=2
bidirectional=true
pooling=attention
dropout=0.15

[partition]
clients_per_modality=10

[pretrain]
objective=classification
epochs=25
batch_size=64
lr=0.0005
weight_decay=0.0001
class_weighting=inverse_sqrt
max_grad_norm=5.0

[fingerprint]
type=signal
batch_size=64
max_batches=4

[fingerprint_visualization]
enabled=true
method=pca
standardize=true
show_client_ids=false
show_ellipses=true
ellipse_confidence=0.95
png_dpi=600

[cluster]
method=adaptive_isodata
known_k=null

[cluster.adaptive]
seeds=[11,23,37,53,71]
max_iter=20
pca_variance=0.95
variance_epsilon=1e-08
q_max=8
min_cluster_size=2
min_cluster_size_fraction=null
bic_improvement_min=0.0
min_split_silhouette=0.2
silhouette_patience=2
stability_min_ari=0.75
split_kmeans_restarts=50

[training]
cluster_assignment_source=true_cluster
scheduler=balanced_cluster_round_robin
global_rounds=200
validation_enabled=false
local_steps=1
batch_size=64
eval_batch_size=128
clients_per_cluster_per_round=4
client_lr=0.0002
server_lr=0.0002
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=inverse_sqrt

[binding]
type=label_random
batch_size=64

[fusion]
type=concat_mlp
training_objective=mmbind_weighted_contrastive
adapter_dim=128
hidden_dim=256
num_layers=2
dropout=0.15

[fusion.mmbind]
temperature=0.1
contrastive_weight=0.1
heterogeneous_ce_weight=0.5

[evaluation]
run_test=true

[d2d]
enabled=false
