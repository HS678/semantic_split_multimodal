# 配置字段参考模板（新 6 段格式）。每个数据集 config 为独立完整文件，不继承。
# 段划分：config（通用/路径）→ partition（Stage1）→ cluster（Stage2）→ train（Stage3）→ d2d → other。
# 列表/字典用 JSON，布尔用 true/false，空值用 null。class_weighting 用 true/false（true=inverse_sqrt，false=none）。

[config]
# str：实验语义名称（进入配置快照）。
experiment_name=uci_har_formal_msl
# int：随机种子；多 seed 实验由启动脚本 --seed 覆盖。
seed=42
# auto/cpu/cuda：运行设备。
device=auto
# int：分类类别数（uci_har=6，mhealth=12，pamap2=12，iemocap=4）。
num_classes=6
# path：结果根目录；Stage1/2/3 输出路径由 base_dir + 数据集 + split_protocol 自动生成。
base_dir=./local/results_msl

[partition]
# 数据集注册名：uci_har/mhealth/pamap2/iemocap。
type=uci_har
# path：原始数据根目录。
root=./local/datasets/uci_har
# str：数据划分协议标识（决定 partition/cluster 目录签名）：
# uci_har=subject_disjoint_70_30；mhealth=subject_5fold_foldN；
# pamap2=subject_9fold_loso_foldN；iemocap=session_5fold_loso_foldN。
split_protocol=subject_disjoint_70_30
# int > 0：每个真实模态拆成的单模态客户端数。
clients_per_modality=10
# iemocap 数据集附加字段：name/variant/processed_root/feature_recipe/task/label_protocol。
# 数据划分、滑窗/预处理、模态方案均内置在数据集代码中，不在配置设置；无验证集。

[cluster]
# Stage2 预训练（encoder 用任务标签做分类，不读模态身份）。
pretrain_objective=classification
pretrain_epochs=25
pretrain_batch_size=64
pretrain_lr=0.0005
# true=按类别频率倒数平方根加权；false=不加权。
pretrain_class_weighting=false
# 指纹：hybrid=encoder 激活统计+信号统计；signal=仅信号统计。
fingerprint_type=hybrid
# 聚类：adaptive_isodata（known_k 必须 null）。
method=adaptive_isodata
known_k=null
# adaptive_isodata 参数（前缀 adaptive_）。
adaptive_seeds=[11,23,37,53,71]
adaptive_max_iter=20
adaptive_pca_variance=0.95
adaptive_variance_epsilon=1e-08
adaptive_q_max=8
adaptive_min_cluster_size=2
adaptive_min_cluster_size_fraction=null
adaptive_bic_improvement_min=0.0
adaptive_min_split_silhouette=0.2
adaptive_silhouette_patience=2
adaptive_stability_min_ari=0.75
adaptive_split_kmeans_restarts=50

[train]
# Stage3 训练：true_cluster=oracle 上限；pred_cluster=正式无泄漏主线（聚类调好后切换）。
cluster_assignment_source=true_cluster
# 每轮按预测簇覆盖调度（当前唯一实现；后续随机调度对比在此切换）。
scheduler=balanced_cluster_round_robin
global_rounds=200
local_steps=1
batch_size=64
eval_batch_size=128
clients_per_cluster_per_round=4
client_lr=0.0002
server_lr=0.0002
client_weight_decay=0.0001
server_weight_decay=0.0001
max_grad_norm=5.0
class_weighting=false
# 客户端 encoder（iemocap 用 gru，其余 temporal_conv_gru；多模态子 encoder 用 [train.encoders.<name>] 子段）。
encoder_type=temporal_conv_gru
encoder_conv_channels=[64,128,128]
encoder_kernel_sizes=[7,5,3]
encoder_gru_hidden_dim=128
encoder_gru_layers=2
encoder_bidirectional=true
encoder_pooling=attention
encoder_dropout=0.2
# 伪绑定：label_random（label-guided semantic pseudo binding）。
binding_type=label_random
binding_batch_size=64
# 融合：concat_mlp（ClusterAdapter + Concat + Classifier）。
fusion_type=concat_mlp
# loss 方式：label_random_ce / mmbind_weighted_contrastive（保留两种，config 可切换）。
fusion_training_objective=mmbind_weighted_contrastive
fusion_adapter_dim=128
fusion_hidden_dim=256
fusion_num_layers=2
fusion_dropout=0.2
# mmbind 损失权重（仅 mmbind_weighted_contrastive 时生效）。
mmbind_temperature=0.1
mmbind_contrastive_weight=0.02
mmbind_heterogeneous_ce_weight=0.1
# 固定轮数训练后，用 last_model.pt 对 test_multimodal.pt 评估一次。
run_test=true

[d2d]
# 计算卸载模块（未实现，保留扩展口）。
enabled=false

[other]
# 辅助配置：指纹 PCA 审计图等可视化/绘图选项。
fingerprint_visualization=true
