# 配置字段参考模板。格式为 INI；列表/字典使用 JSON，布尔值使用 true/false，空值使用 null。
# 正式实验优先修改对应数据集 .config。本文件含占位路径，不应直接运行。
[config]
# path：可选，继承另一个 .config；相对路径以当前配置文件目录为基准，子配置按 section/key 深度覆盖。
# extends=../uci_har.config
# int：全流程随机种子；多 seed 实验直接修改该值，seed 会单独进入结果目录。
seed=42
# auto/cpu/cuda/cuda:0...：PyTorch 运行设备。
device=auto
# str：实验语义名称，进入配置快照和 config signature 哈希。
experiment_name=dataset_three_stage
# int：分类类别数，必须与数据集标签协议一致。
num_classes=6
# int：客户端 encoder 输出维度，也是 ClusterAdapter 输入维度。
encoder_hidden_dim=128

[results]
# path：Stage1/2/3 统一结果根；正式输出固定在 local/results/。
base_dir=./local/results

[stage2]
# Stage2 只需 --config 时读取的冻结 Stage1 输入和聚类输出根目录。
stage1_dir=./local/results/partition/<dataset>/<partition_signature>
output_root=./local/results/cluster
# str/null：可选的 Stage2 配置标识子目录；用于保留同一 partition/method 的多套预训练或聚类参数结果。
run_name=null

[stage3]
# Stage3 只需 --config 时读取的冻结输入、实验根目录与显式重复实验编号。
stage1_dir=./local/results/partition/<dataset>/<partition_signature>
stage2_dir=./local/results/cluster/<dataset>/<partition_signature>/adaptive_isodata
output_root=./local/results/experiments
# 正整数。同配置、同 seed 重跑时手动递增；已有目录永不覆盖。
attempt=1

[dataset]
# uci_har/mhealth/pamap2/cmu_mosei/iemocap：数据集适配器注册名。
type=uci_har
# path：原始数据根目录。
root=./local/datasets/uci_har
# str：写入 Stage1 partition signature 的数据划分协议标识；改变划分时必须同步改变该值。
split_protocol=subject_disjoint_tvt_v1
# JSON int list：仅 subject 数据集使用，三组必须非空、互斥。
train_subjects=[]
validation_subjects=[]
test_subjects=[]
# bool：只使用 train split 统计量做标准化。
normalize=true
# mhealth/pamap2 专用字段：
# modality_scheme=sensor_type 或 position；window_size/stride 为正整数；
# min_label_purity 为 (0,1]；drop_null/drop_other/include_heart_rate 为 bool。
# cmu_mosei 专用字段：
# features_dir/splits_dir 为相对 root 的目录；text_file/audio_file/visual_file 为特征文件；
# train_split_file/validation_split_file/test_split_file 为官方划分文件；
# task=binary_sentiment，label_protocol=negative_vs_non_negative，temporal_pooling=mean。
# iemocap 专用字段：
# name=iemocap，variant=full；processed_root 为预处理特征目录；
# feature_recipe=mfcc_mobilevit_xs_distilbert_v1（audio MFCC、video MobileViT-XS、text DistilBERT）；
# 固定划分：split_strategy=fixed_session_split_v1，配置 train/validation/test_sessions；
# 五折 LOSO：split_strategy=session_loso_5fold_group_validation_v1，每折 test_sessions 仅一个 Session，
# 其余四个 Session 写入 train_sessions；validation_folds>=2、validation_fold_index 从 0 开始、
# validation_seed 为确定性分组种子。验证集只从训练 Session 内按 dialog_id 分组产生。
# task=emotion_4class，label_protocol=ang_hap_exc_sad_neu_v1。

[model.encoder]
# time_series/temporal_conv_gru/mlp/gru/conv_gru：由数据集模态输入决定；
# IEMOCAP payload 分别指定 conv_gru、gru、gru，视频帧特征由 MobileViT-XS 预提取。
type=time_series
# JSON int list：1D Conv 各层通道数；仅适用对应 encoder。
conv_channels=[64,128]
# JSON int list：1D Conv 各层 kernel；IEMOCAP GRU 配置使用单数 kernel_size。
kernel_sizes=[5,3]
# float [0,1)：encoder dropout。
dropout=0.1
# Temporal CNN-GRU/GRU：gru_hidden_dim、gru_layers 为正整数，bidirectional 为 bool，
# pooling=mean/attention；MLP：layer_dims 为 JSON int list、layer_norm 为 bool。
# 视频帧编码器 MobileViT 位于特征预处理阶段，此处 GRU 对预提取后的时序特征建模。
# [model.encoders.gru]/[model.encoders.conv_gru] 可按 payload encoder_type 覆盖公共参数。

[partition]
# int > 0：每个真实模态在 Stage1 拆分出的单模态客户端数。
clients_per_modality=10

[pretrain]
# reconstruction/classification：Stage2 客户端 encoder 预训练目标；classification 使用任务标签，
# 不读取 hidden_modality_id、模态名或自然跨模态配对。
objective=reconstruction
epochs=10
batch_size=64
lr=0.001
weight_decay=0.0
# none/inverse_sqrt：仅 classification 生效；inverse_sqrt 缓和类别不均衡。
class_weighting=none
# null 或 float > 0：梯度范数裁剪阈值。
max_grad_norm=null
# null 或 int > 0：每个客户端最多使用的预训练样本数。
max_samples=null

[fingerprint]
# encoder/signal/hybrid：客户端 fingerprint 构造方式；当前使用 hybrid。
type=hybrid
batch_size=64
# int > 0：每客户端最多提取多少个 batch。
max_batches=4

[fingerprint_visualization]
# bool：Stage2 是否保存 PCA 审计散点图及元数据。
enabled=true
# 当前仅 pca；PCA 输入仅为 fingerprint，不读取真实模态身份。
method=pca
standardize=true
show_client_ids=false
show_ellipses=true
# float (0,1)：协方差椭圆置信水平；png_dpi 为 PNG 分辨率，PDF 为矢量图。
ellipse_confidence=0.95
png_dpi=600

[cluster]
# adaptive_isodata/kmeans：当前不修改聚类算法，继续使用 adaptive_isodata。
method=adaptive_isodata
# adaptive_isodata 必须 null；kmeans 时为已知正整数 K。
known_k=null

[cluster.adaptive]
# 以下字段仅调节现有 adaptive_isodata，不代表本次修改聚类实现。
seeds=[11,23,37,53,71]
max_iter=20
# float (0,1]：聚类前 PCA 累计解释方差比例。
pca_variance=0.95
variance_epsilon=1.0e-8
# int > 0：自适应搜索最大簇数。
q_max=8
# int/null 与 float/null：最小簇样本数的绝对/比例约束。
min_cluster_size=2
min_cluster_size_fraction=null
bic_improvement_min=0.0
# min_split_silhouette/stability_min_ari 为 [-1,1] 内阈值；patience/restarts 为正整数。
min_split_silhouette=0.20
silhouette_patience=2
stability_min_ari=0.75
split_kmeans_restarts=50

[training]
# 当前开发实验固定 true_cluster；论文正式实验后续切换 pred_cluster。
cluster_assignment_source=true_cluster
scheduler=balanced_cluster_round_robin
# int > 0：Stage3 最大全局轮数；local_steps 为每轮本地 Split Learning step 数。
global_rounds=200
local_steps=1
batch_size=64
eval_batch_size=128
# int > 0：naturally paired validation 的轮次间隔。
validation_every=10
# int > 0：每轮每个被覆盖簇选择的客户端数。
clients_per_cluster_per_round=4
client_lr=0.001
server_lr=0.001
# float >= 0：客户端/服务器 Adam weight decay。
client_weight_decay=0.0
server_weight_decay=0.0
# null 或 float > 0：客户端/服务器梯度范数裁剪阈值。
max_grad_norm=null
# none/inverse_sqrt：Stage3 CE 类别权重，只由 Stage1 train client 标签统计。
class_weighting=none

[training.early_stopping]
# patience：连续多少次验证无提升后停止；min_rounds 前禁止停止；min_delta 为最小提升量。
patience=3
min_rounds=50
min_delta=0.001

[binding]
# label_random：当前 label-guided semantic pseudo binding，标签仅提供语义一致性。
type=label_random
batch_size=64

[fusion]
# concat_mlp：固定 ClusterAdapter + Concat Fusion + Classifier。
type=concat_mlp
# label_random_ce/mmbind_weighted_contrastive：两套可配置训练目标，不改变推理结构。
training_objective=label_random_ce
# adapter_dim/hidden_dim/num_layers 为正整数；dropout 为 [0,1)。
adapter_dim=128
hidden_dim=128
num_layers=1
dropout=0.0

[fusion.mmbind]
# 仅 training_objective=mmbind_weighted_contrastive 时生效。
# temperature > 0；两个 weight 均为非负浮点数。
temperature=0.1
contrastive_weight=0.1
heterogeneous_ce_weight=0.5

[evaluation]
# true：加载 validation 选出的 best_model.pt 后，对 naturally paired test_multimodal.pt 仅评估一次；
# false：pilot 只保存验证结果并把 test 标为 deferred，不产生正式 test 指标。
run_test=true

[d2d]
# 当前固定 false；仅保留未来快客户端帮助慢客户端的时延扩展入口。
enabled=false
