# 配置字段参考模板（精简版）。每个数据集 config 为独立完整文件（约 14 行）。
# 每个数据集的固定参数（num_classes、root、pretrain、fingerprint、encoder、
# 训练 batch/lr、binding、fusion dropout、mmbind 权重、聚类参数等）内置在
# src/MSL/data/dataset_defaults.py，config 只需设置"要切换或要调"的字段。
# 路径由 base_dir + 数据集 + split_protocol 自动生成；无验证集；normalize 内置。

[config]
# str：实验语义名称（进入配置快照）。
experiment_name=uci_har_msl
# path：结果根目录（Stage1/2/3 输出自动生成）。
base_dir=./local/results_msl
# seed / device 已内置默认（seed=42，device=auto），多 seed 由启动脚本 --seed 覆盖。

[partition]
# 数据集注册名：uci_har/mhealth/pamap2/iemocap（决定默认参数表）。
type=uci_har
# str：数据划分协议（决定目录签名）：
# uci_har=subject_disjoint_70_30；mhealth=subject_5fold_foldN；
# pamap2=subject_9fold_loso_foldN；iemocap=session_5fold_loso_foldN。
split_protocol=subject_disjoint_70_30
# int > 0：每个真实模态拆成的单模态客户端数（客户端数变体实验在此调整）。
clients_per_modality=10

[train]
# true_cluster=oracle 上限；pred_cluster=正式无泄漏主线（聚类调好后切换）。
cluster_assignment_source=true_cluster
# 每轮按预测簇覆盖调度（后续随机调度对比实验在此切换）。
scheduler=balanced_cluster_round_robin
# loss 方式：label_random_ce / mmbind_weighted_contrastive（两种保留，可切换）。
fusion_training_objective=mmbind_weighted_contrastive
# int > 0：固定训练轮数（无验证集，直接调轮数）。
global_rounds=200

# D2D 计算卸载模块：尚未实现，保留扩展口（正式实验保持 false）。
[d2d]
# bool：是否启用 D2D（未来实现后置 true）。
enabled=false

# 杂项/可视化：指纹 PCA 审计图等辅助输出开关。
[other]
# bool：Stage2 是否输出 fingerprint PCA 审计图（论文可视化用）。
fingerprint_visualization=true
# 其余字段（method=pca、standardize=true、show_client_ids=false、
# show_ellipses=true、ellipse_confidence=0.95、png_dpi=600）均内置默认，
# 需要调整时在此覆盖。
